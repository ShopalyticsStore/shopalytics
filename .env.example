# Application
DATABASE_URL=postgres://shopalytics@127.0.0.1:5432/shopalytics
DATABASE_SSL=false
SHOPALYTICS_DATABASE_SCHEMA=shopalytics_fixture
SHOPALYTICS_FIXTURE_CLOCK=2026-09-14T09:00:00Z
UTRACE_PROFILE=production
NEXT_PUBLIC_UTRACE_PROFILE=production

# Seeding targets. Point them at the base and candidate runtime databases.
SHOPALYTICS_BASE_DATABASE_URL=postgres://shopalytics@127.0.0.1:5432/shopalytics
SHOPALYTICS_CANDIDATE_DATABASE_URL=postgres://shopalytics@127.0.0.1:5432/shopalytics_candidate

# Preview profile only. Injected by the uTrace preview runtime, never committed.
# UTRACE_PREVIEW_HANDOFF_SECRET=
# UTRACE_PREVIEW_ROUTE_SIGNING_SECRET=
# SHOPALYTICS_FIXTURE_MANIFEST_HASH=
# The browser SDK's whole static configuration. It carries no secret and no
# identity; everything else arrives in the signed document attestation.
# NEXT_PUBLIC_UTRACE_SDK_INSTALLATION_ID=
# NEXT_PUBLIC_UTRACE_CLIENT_RELEASE_ID=
# The Server SDK's bootstrap, injected by the prepared environment.
# UTRACE_SERVER_BOOTSTRAP_CREDENTIAL=
# UTRACE_SERVER_CONTROL_URL=
# UTRACE_SERVER_INGEST_URL=
# UTRACE_SERVER_SERVICE_NAME=shopalytics_web
# UTRACE_SERVER_MANIFEST_TRUST_ANCHOR=

# Database test suite (npm run test:db)
# SHOPALYTICS_TEST_DATABASE_URL=
