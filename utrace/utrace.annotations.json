  "approved_trace_origins": [],
  "redaction": {
    "redaction_version": "shopalytics-r-1",
    "policy_version": "shopalytics-p-1",
    "safe_value_rules": [
      {
        "rule_id": "safe.control_label",
        "allowed_kinds": [
          "accessible_label"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 60
      },
      {
        "rule_id": "safe.date_range_preset",
        "allowed_kinds": [
          "annotation_attribute"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 16,
        "allowed_values": [
          "last_7_days",
          "last_30_days",
          "last_90_days",
          "custom"
        ]
      },
      {
        "rule_id": "safe.dimension_name",
        "allowed_kinds": [
          "annotation_attribute",
          "accessible_label"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 64,
        "allowed_pattern": "[A-Za-z0-9 ,+&'\u2019/-]{1,64}"
      },
      {
        "rule_id": "safe.selection_count",
        "allowed_kinds": [
          "annotation_attribute"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 4,
        "allowed_pattern": "[0-9]{1,4}"
      },
      {
        "rule_id": "safe.series_id",
        "allowed_kinds": [
          "annotation_attribute"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 64,
        "allowed_pattern": "[a-z_+]{1,64}"
      },
      {
        "rule_id": "safe.series_label",
        "allowed_kinds": [
          "annotation_attribute",
          "accessible_label"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 120,
        "allowed_pattern": "[A-Za-z0-9 ,+&'\u2019/-]{1,120}"
      },
      {
        "rule_id": "safe.surface_id",
        "allowed_kinds": [
          "annotation_attribute"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 32,
        "allowed_values": [
          "conversion_trend",
          "conversion_kpis",
          "product_breakdown",
          "review_list"
        ]
      },
      {
        "rule_id": "safe.render_status",
        "allowed_kinds": [
          "annotation_attribute"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 8,
        "allowed_values": [
          "rendered",
          "empty"
        ]
      },
      {
        "rule_id": "safe.view_name",
        "allowed_kinds": [
          "form_value",
          "annotation_attribute"
        ],
        "output_class": "bounded_safe_value",
        "max_length": 60,
        "allowed_pattern": "[\\w ,'-]{1,60}"
      },
      {
        "rule_id": "safe.view_ref",
        "allowed_kinds": [
          "annotation_attribute"
        ],
        "output_class": "pseudonymized",
        "max_length": 64
      },
      {
        "rule_id": "safe.product_ref",
        "allowed_kinds": [
          "annotation_attribute"
        ],
        "output_class": "pseudonymized",
        "max_length": 64
      }
    ],
    "sensitive_surfaces": [
      "account_settings"
    ],
    "sensitive_fields": [
      "reviewer_email",
      "reviewer_name",
      "billing_card"
    ]
  }
}
