{
  "name": "shopalytics",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "start:preview": "node --import ./utrace/preload.mjs node_modules/next/dist/bin/next start -p 3300",
    "utrace:vendor": "node --import tsx scripts/utrace/vendor.ts",
    "utrace:manifest": "node --import tsx scripts/utrace/manifests.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:lockfile": "npm ci --dry-run --no-audit --no-fund",
    "test": "npm run check:lockfile && node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "format": "prettier --write .",
    "fixture:generate": "node --env-file-if-exists=.env.local --import tsx scripts/fixtures/generate.ts",
    "db:seed:base": "node --env-file-if-exists=.env.local --import tsx scripts/db/setup.ts base",
    "db:seed:candidate": "node --env-file-if-exists=.env.local --import tsx scripts/db/setup.ts candidate"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
